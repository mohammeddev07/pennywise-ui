# Copy to .env.local for development. Only VITE_* variables reach the browser bundle; never put secrets here.

# Backend base URL, including /api. Local backend: http://localhost:8080/api
VITE_API_BASE_URL=https://pennywise-7v9g.onrender.com/api

# "true" runs against the in-memory mock backend (no server needed; export is unavailable).
VITE_MOCK_API=false

# Google OAuth *web* client ID (same one listed in the backend's GOOGLE_CLIENT_IDS). Leave empty to hide Google sign-in.
VITE_GOOGLE_CLIENT_ID=

# Optional: shows "Contact support" in Profile as a mailto link.
VITE_SUPPORT_EMAIL=
